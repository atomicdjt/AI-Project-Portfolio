{
  "name": "variantvision-pro",
  "private": true,
  "version": "1.0.0",
  "description": "A static-deployable bioinformatics evidence workbench for educational variant review, source transparency, and non-diagnostic research triage.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5182",
    "build": "tsc -b && vite build",
    "lint": "eslint src vite.config.ts vitest.config.ts",
    "test": "vitest run",
    "preview": "npm run build && vite preview --host 127.0.0.1 --port 4182"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.11"
  }
}
