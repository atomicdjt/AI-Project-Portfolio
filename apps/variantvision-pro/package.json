{
  "name": "variantvision-pro",
  "private": true,
  "version": "1.0.0",
  "description": "An educational variant evidence workbench with assembly-aware teaching coordinates, attributed source leads, and a PubMed metadata endpoint.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5182",
    "prebuild": "node scripts/verify-vercel-typescript.mjs && node scripts/verify-vercel-function.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint src api server e2e vite.config.ts vitest.config.ts playwright.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test": "vitest run",
    "preview": "npm run build && vite preview --host 127.0.0.1 --port 4182"
  },
  "dependencies": {
    "lucide-react": "^1.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.0.12",
    "vitest": "^5.0.5"
  }
}
