{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "github": {
    "enabled": false
  },
  "ignoreCommand": "node ../../scripts/vercel-ignore-build-step.mjs --project variantvision-pro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
