{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "github": {
    "enabled": false
  },
  "ignoreCommand": "node ../../scripts/vercel-ignore-build-step.mjs --project portfolio-hub",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/review",
      "destination": "/review.html"
    },
    {
      "source": "/review/",
      "destination": "/review.html"
    },
    {
      "source": "/projects/validation-ledger",
      "destination": "/projects/validation-ledger.html"
    },
    {
      "source": "/projects/agent-session-bridge",
      "destination": "/projects/agent-session-bridge.html"
    },
    {
      "source": "/projects/buildworld-ai",
      "destination": "/projects/buildworld-ai.html"
    },
    {
      "source": "/projects/weavestudio",
      "destination": "/projects/weavestudio.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
